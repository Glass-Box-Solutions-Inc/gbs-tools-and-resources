{
  "name": "@glass-box-solutions-inc/phi-substitution-engine",
  "version": "0.1.0",
  "description": "Deterministic PHI substitution engine (phase-1 frozen contract). Framework-free core with opt-in adapters.",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
