{
  "name": "@glass-box-solutions-inc/phi-substitution-engine",
  "version": "0.2.0",
  "description": "Deterministic PHI substitution engine (phase-1 frozen contract). Framework-free core with opt-in adapters.",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CONTRACT"
  ],
  "scripts": {
    "build": "tsc",
    "build:executables": "tsc -p tsconfig.executables.json",
    "smoke:q6": "tsx smoke/q6-smoke.ts",
    "job:reclaim": "tsx jobs/reclaim-entrypoint.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.public-api.json --noEmit && tsc -p tsconfig.executables.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"type-tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"type-tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.21.0",
    "eslint": "9.39.1",
    "prettier": "3.7.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.50.0",
    "vitest": "^3.1.4"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@azure/identity": "4.13.1",
    "@azure/keyvault-keys": "4.10.2",
    "@azure/storage-file-share": "12.31.0",
    "pg": "^8.23.0"
  }
}
